{
  "name": "@secondbrain/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite",
    "editor:benchmark": "node scripts/editor-gate.mjs",
    "editor:gate": "npm run editor:survival && cargo test --locked --manifest-path src-tauri/Cargo.toml markdown_corpus_survives_desktop_preview_and_apply",
    "editor:survival": "vitest run src/lib/editor-markdown-corpus.test.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "scripts:test": "node --test scripts/*.test.mjs",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tiptap/core": "3.29.0",
    "@tiptap/pm": "3.29.0",
    "@tiptap/starter-kit": "3.29.0",
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "26.1.0",
    "svelte-check": "4.3.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
